{
  "name": "grindcade",
  "private": true,
  "version": "0.8.0",
  "description": "A retro-terminal command center for tasks, kanban, calendar, focus timer and a Snake arcade.",
  "author": "Grindcade",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app": "vite build && electron .",
    "package": "vite build && electron-packager . Grindcade --platform=win32 --arch=x64 --out=release --overwrite --icon=build/icon.ico --prune=true --ignore=\"(^/src$|^/release$|tsconfig.*|vite.config.*|\\.zip$|\\.md$|^/build$|^/\\.env$|^/\\.github$|make-icon\\.ps1)\"",
    "package:mac": "vite build && electron-packager . Grindcade --platform=darwin --arch=universal --out=release --overwrite --icon=build/icon.icns --app-bundle-id=com.tatetime.termdeck --prune=true --ignore=\"(^/src$|^/release$|tsconfig.*|vite.config.*|\\.zip$|\\.md$|^/build$|^/\\.env$|^/\\.github$|make-icon\\.ps1)\"",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.termdeck.app",
    "productName": "Grindcade",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grindcade"
    }
  }
}
